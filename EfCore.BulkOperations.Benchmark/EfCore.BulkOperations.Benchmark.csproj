<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- A console project is packable by default. This one is a harness, not a package;
             without this it would be pushed to nuget.org alongside the library. -->
        <IsPackable>false</IsPackable>
        <!-- A harness, not shipped code. Analysing it adds smells nobody will act on and
             coverage nobody should write. -->
        <SonarQubeExclude>true</SonarQubeExclude>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\EfCore.BulkOperations.Test\EfCore.BulkOperations.Test.csproj"/>
        <ProjectReference Include="..\EfCore.BulkOperations\EfCore.BulkOperations.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.14.0"/>
    </ItemGroup>

</Project>
